# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs (Foundry default). Keep the live art lock checked in.
docs/
!docs/MAIN_ART_LOCK.md

# Dotenv file
.env
.env.*
!.env.example

# Next.js dapp
web/node_modules/
web/.next/
web/out/
web/.env.local
web/.vercel
.vercel
node_modules/
.next/
deployments/*
!deployments/.gitkeep

# Generated artifacts
artifacts/*
agent-tools/

# Art generator (vendored package lives in art/; do not commit full 4444 export)
art/**/__pycache__/
art/**/*.pyc
art/.venv/
art/export/gif-full/

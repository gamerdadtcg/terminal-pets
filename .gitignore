# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs (Foundry default). Keep the live art lock, Dial notes, SeaDrop Studio guide, testnet deploy plan, Studio dry-run, mainnet prep, and recorded 46630 addresses checked in.
docs/*
!docs/MAIN_ART_LOCK.md
!docs/DIAL.md
!docs/OPENSEA_STUDIO_SEADROP.md
!docs/TESTNET_DEPLOY.md
!docs/RH_TESTNET_DEPLOY_ADDRESSES.md
!docs/RH_TESTNET_MICRO_SMOKE.md
!docs/STUDIO_DROP_DRYRUN.md
!docs/MAINNET_PREP.md
!docs/ARCADE_BUILD_BRIEF.md

# Dotenv file
.env
.env.*
!.env.example
!.env.production
!web/.env.production

# Next.js dapp
web/node_modules/
web/.next/
web/out/
web/.env.local
web/.vercel
.vercel
node_modules/
.next/
deployments/*
!deployments/.gitkeep
!deployments/robinhood-testnet.json
!deployments/robinhood-testnet-micro.json
!deployments/robinhood-mainnet.json

# Generated artifacts
artifacts/*
agent-tools/

# Art generator (vendored package lives in art/; do not commit full 4444 export)
art/**/__pycache__/
art/**/*.pyc
art/.venv/
art/export/gif-full/

# Anti-snipe: never commit live collection metadata trees until after reveal
web/public/metadata/lit/
web/public/metadata/dormant/

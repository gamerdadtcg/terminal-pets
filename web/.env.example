# Canonical public site. Default in web/lib/site.ts is https://terminalpets.xyz.
# https://terminal-pets.vercel.app still resolves as a fallback alias until DNS
# is fully cut over. Override only if you need a preview / local origin.
# NEXT_PUBLIC_SITE_URL=https://terminalpets.xyz

# Robinhood Chain mainnet (production). Fill addresses after 4663 deploy.
# Do not broadcast to 4663 from the hub repo. mintOpen is on-chain.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

NEXT_PUBLIC_COLLECTION_NFT=
NEXT_PUBLIC_COLLECTION_ADDRESS=
NEXT_PUBLIC_IGNITE_ADDRESS=
NEXT_PUBLIC_HOPPER_ADDRESS=
NEXT_PUBLIC_PULSE_ADDRESS=
NEXT_PUBLIC_SPLITTER_ADDRESS=
NEXT_PUBLIC_TERM_ADDRESS=
NEXT_PUBLIC_TERM_FUND_ADDRESS=
NEXT_PUBLIC_TERM_MARKET_ADDRESS=

NEXT_PUBLIC_OPENSEA_URL=
NEXT_PUBLIC_X_URL=

# ---------------------------------------------------------------------------
# Base Sepolia dry-run (testing only, chain 84532).
# Studio Drop create currently has no BYO import and no Base Sepolia.
# Hub mint is the primary path. CollectionNFT.mint / mintTo while mintOpen.
# If NEXT_PUBLIC_CHAIN_ID=84532 and collection env is blank, the hub falls
# back to this dry-run CollectionNFT. Override any address by setting it.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_CHAIN_ID=84532
# NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
# NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org

# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs (Foundry default). Keep the live art lock, Dial notes, SeaDrop Studio guide, testnet deploy plan, and recorded 46630 addresses checked in.
docs/*
!docs/MAIN_ART_LOCK.md
!docs/DIAL.md
!docs/OPENSEA_STUDIO_SEADROP.md
!docs/TESTNET_DEPLOY.md
!docs/RH_TESTNET_DEPLOY_ADDRESSES.md
!docs/RH_TESTNET_MICRO_SMOKE.md

# Dotenv file
.env
.env.*
!.env.example

# Next.js dapp
web/node_modules/
web/.next/
web/out/
web/.env.local
web/.vercel
.vercel
node_modules/
.next/
deployments/*
!deployments/.gitkeep
!deployments/robinhood-testnet.json
!deployments/robinhood-testnet-micro.json

# Generated artifacts
artifacts/*
agent-tools/

# Art generator (vendored package lives in art/; do not commit full 4444 export)
art/**/__pycache__/
art/**/*.pyc
art/.venv/
art/export/gif-full/

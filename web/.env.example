# Canonical public site. Default in web/lib/site.ts is https://terminalpets.xyz.
# https://terminal-pets.vercel.app still resolves as a fallback alias until DNS
# is fully cut over. Override only if you need a preview / local origin.
# NEXT_PUBLIC_SITE_URL=https://terminalpets.xyz

# Robinhood Chain mainnet (production, chain 4663).
# Production builds also load web/.env.production with these same addresses.
# mintOpen is on-chain (still false). Do not fake it open. No forge broadcast.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

NEXT_PUBLIC_COLLECTION_NFT=0x85e3f98b76b0a6c9166BA7aaB05BEc4ef17B7166
NEXT_PUBLIC_COLLECTION_ADDRESS=0x85e3f98b76b0a6c9166BA7aaB05BEc4ef17B7166
NEXT_PUBLIC_IGNITE_ADDRESS=0x29e8dB2073583720C3CBf741d278d942B65cb92B
NEXT_PUBLIC_HOPPER_ADDRESS=0x8Cd9A113dc8147D5163486e81D3bA64E2137dBf2
NEXT_PUBLIC_PULSE_ADDRESS=0x7326F7D277610288FBeA373712c89E47AF9AC61E
NEXT_PUBLIC_SPLITTER_ADDRESS=0xe1cC988CeC1C29764ba18523635De82d0C9B518F
NEXT_PUBLIC_TERM_ADDRESS=0xCa75Bc5eD48Bd9B8D1a939253e40e7AE3e61DAA6
NEXT_PUBLIC_TERM_FUND_ADDRESS=0x0C25076F1bF9f6187ed3b7D890F480a92837636F
NEXT_PUBLIC_TERM_MARKET_ADDRESS=0x78f2c0577321053722Daa1f5eE31E5071a7D9F30

NEXT_PUBLIC_OPENSEA_URL=
NEXT_PUBLIC_X_URL=

# ---------------------------------------------------------------------------
# Base Sepolia dry-run (testing only, chain 84532).
# Studio Drop create currently has no BYO import and no Base Sepolia.
# Hub mint is the primary path. CollectionNFT.mint / mintTo while mintOpen.
# Fallback applies only when NEXT_PUBLIC_CHAIN_ID=84532 (or chain env is blank
# in local `next dev`). Production / main always uses the 4663 addresses above.
# Override any address by setting it.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_CHAIN_ID=84532
# NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
# NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org
